PORT=3001
FRONTEND_URL=http://localhost:5173
DATABASE_URL=

# Required to create/modify/delete master data records (see src/auth.js).
# The master-data MCP server must send this as the x-internal-api-key
# header on every write. Generate a real random value, e.g. `openssl rand
# -hex 32` — do not use a placeholder in any real deployment.
INTERNAL_API_KEY=

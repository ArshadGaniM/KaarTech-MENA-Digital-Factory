# Copy to .env and fill in real values. Never commit .env.
# See CLAUDE.md §20 — populated as a backend/integrations are added.

# DATABASE_URL=
# REDIS_URL=
# SECRET_KEY=

# Frontend: base URL of the backend API (backend/.env's PORT). Vite only
# exposes vars prefixed VITE_ to client code.
# VITE_BACKEND_URL=http://localhost:3001

# FEAT-14: must exactly match the backend's INTERNAL_API_KEY so the
# browser's "Add <Entity>" forms can write records. Vite inlines VITE_
# vars into the built JS bundle, so this key is visible to anyone who
# opens the site's network tab or reads the bundle — it stops being a
# real secret the moment the browser needs to send it. Accepted for now:
# this app has no user-login system yet (CLAUDE.md §20), same category as
# every other "no auth system yet" limitation already logged there. Do
# not treat this as equivalent to a server-side secret.
# VITE_INTERNAL_API_KEY=
